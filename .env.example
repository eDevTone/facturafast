# =============================================================================
# FacturaFast — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Clerk Auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── CSD Certificate Encryption (AES-256, 64 hex chars) ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERTIFICATE_ENCRYPTION_KEY=

# ── SW Sapien PAC (CFDI Stamping) ───────────────────────────────────────────
# Test: https://services.test.sw.com.mx
# Production: https://services.sw.com.mx
SW_URL=https://services.test.sw.com.mx
SW_TOKEN=

# ── Cloudflare R2 Storage ───────────────────────────────────────────────────
# Dashboard: https://dash.cloudflare.com → R2 → Manage API Tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=facturafast-invoices

# ── Payment Provider Switch ─────────────────────────────────────────────────
# Selects which provider handles new checkouts. Webhooks for both stay active
# regardless (async payments like OXXO/SPEI can arrive days later).
# Values: conekta | stripe. Defaults to 'conekta' if unset.
PAYMENT_PROVIDER=conekta

# ── Conekta (Payments) ──────────────────────────────────────────────────────
# Dashboard: https://panel.conekta.com → Developers → API Keys
# Use key_test_xxx for sandbox, key_xxx for production
CONEKTA_API_KEY=key_test_xxxxx
CONEKTA_PRODUCT_STARTER=ff-stamps-starter
CONEKTA_PRODUCT_BASICO=ff-stamps-basico
CONEKTA_PRODUCT_PRO=ff-stamps-pro
CONEKTA_PRODUCT_BUSINESS=ff-stamps-business

# ── Stripe (Payments) ───────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com → Developers → API keys
# Use sk_test_xxx for sandbox, sk_live_xxx for production
STRIPE_SECRET_KEY=sk_test_xxxxx
# Webhooks: https://dashboard.stripe.com → Developers → Webhooks
# For local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Events to subscribe: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Resend (Email) ──────────────────────────────────────────────────────────
# Dashboard: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxx
RESEND_FROM=FacturaFast <onboarding@resend.dev>

# ── App URL (for payment provider redirects) ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
